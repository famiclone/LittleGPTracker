-include $(PWD)/rules_base

#---------------------------------------------------------------------------------
# TrimUI Brick / Smart Pro (Allwinner A133p, "tg5040") running NextUI.
#
# Prefer the NextUI crosstool (x86_64 host) when available. On Apple Silicon,
# set LGPT_TG5040_USE_CLANG=1 to build with clang against the same sysroot
# (avoids qemu-user ICE in the x86_64 gcc binary).
#
#   make PLATFORM=TG5040 DEVKIT=/path/to/aarch64-nextui-linux-gnu
#   make PLATFORM=TG5040 DEVKIT=/path/to/aarch64-nextui-linux-gnu LGPT_TG5040_USE_CLANG=1
#---------------------------------------------------------------------------------

DEFINES := \
	-DPLATFORM_$(PLATFORM) \
	-D_64BIT \
	-DBUFFERED \
	-DCPP_MEMORY \
	-DHAVE_STDINT_H \
	-D_NDEBUG \
	-D_NO_JACK_ \
	-DSDL2 \
	-DSDLAUDIO \
	-DDUMMYMIDI

DEVKIT ?= /opt/tg5040-nextui-toolchain
TRIPLET := aarch64-nextui-linux-gnu
SYSROOT := $(DEVKIT)/$(TRIPLET)/libc

ifeq ($(LGPT_TG5040_USE_CLANG),1)
DEVKITARM := /usr
CC    = clang
CXX   = clang++
STRIP = llvm-strip
TOOLPATH = /usr/bin
CXXINC := $(DEVKIT)/$(TRIPLET)/include/c++/8.3.0
GCCLIB := $(DEVKIT)/lib/gcc/$(TRIPLET)/8.3.0
TARGET_FLAGS := --target=aarch64-linux-gnu --sysroot=$(SYSROOT) \
	--gcc-toolchain=$(DEVKIT) \
	-isystem $(CXXINC) \
	-isystem $(CXXINC)/$(TRIPLET) \
	-B$(DEVKIT)/bin -B$(GCCLIB)
SDL_CFLAGS := -D_REENTRANT -I$(SYSROOT)/usr/include/SDL2
SDL_LIBS   := -lSDL2
OPT_FLAGS = -O2 -march=armv8-a -fstack-protector-strong
INCLUDES = -Iinclude $(SDL_CFLAGS) -I$(PWD)/../sources
CFLAGS   := $(DEFINES) $(INCLUDES) $(OPT_FLAGS) $(TARGET_FLAGS) -Wall
CXXFLAGS := $(CFLAGS) -std=gnu++03
LDFLAGS  := $(TARGET_FLAGS) -fuse-ld=lld \
	-L$(SYSROOT)/usr/lib \
	-L$(DEVKIT)/$(TRIPLET)/lib64 \
	-L$(GCCLIB) \
	-Wl,-rpath-link,$(SYSROOT)/usr/lib
LIBS     := $(SDL_LIBS) -lpthread -lstdc++ -lm -lc -lgcc_s -lgcc
else
CROSS_COMPILE := $(DEVKIT)/bin/$(TRIPLET)-
DEVKITARM := $(DEVKIT)
CC    = $(CROSS_COMPILE)gcc
CXX   = $(CROSS_COMPILE)g++
STRIP = $(CROSS_COMPILE)strip
TOOLPATH = $(DEVKIT)/bin
SDL_CFLAGS := -D_REENTRANT -I$(SYSROOT)/usr/include/SDL2
SDL_LIBS   := -lSDL2
OPT_FLAGS = -O3 -march=armv8-a+crypto+crc -fasynchronous-unwind-tables \
            -fstack-protector-strong -Wformat -Wformat-security
INCLUDES = -Iinclude $(SDL_CFLAGS) -I$(PWD)/../sources
CFLAGS   := $(DEFINES) $(INCLUDES) $(OPT_FLAGS) -Wall
CXXFLAGS := $(CFLAGS) -std=gnu++03
LIBS     := $(SDL_LIBS) -lpthread
endif

OUTPUT    = ../lgpt-tg5040
EXTENSION := elf

%.elf: $(OFILES)
	$(CXX) $(LDFLAGS) -o $@ $(OFILES) $(LIBS)
	@$(STRIP) $@
